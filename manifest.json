{
  "manifest_version": 3,
  "name": "Studocu Uncensored",
  "version": "2.0",
  "description": "Remove blur, watermarks, and export Studocu documents to clean PDF with one click.",
  "minimum_chrome_version": "101",

  "permissions": [
    "cookies",
    "scripting",
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "*://*.studocu.com/*",
    "*://*.studocu.vn/*"
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }

}
